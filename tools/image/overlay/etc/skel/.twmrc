# twm for the desktop on `/`: stock look, plus the Icon Manager as a taskbar
# along the bottom edge. New windows are placed without the rubber-band
# prompt; the dock (/usr/local/bin/dock) is override-redirect, twm ignores it.

NoGrabServer
RestartPreviousState
DecorateTransients
RandomPlacement
UsePPosition "on"
IconifyByUnmapping
NoMenuShadows

TitleFont "-adobe-helvetica-bold-r-normal--*-120-*-*-*-*-*-*"
ResizeFont "-adobe-helvetica-bold-r-normal--*-120-*-*-*-*-*-*"
MenuFont "-adobe-helvetica-bold-r-normal--*-120-*-*-*-*-*-*"
IconManagerFont "-adobe-helvetica-bold-r-normal--*-100-*-*-*"

ShowIconManager
IconManagerGeometry "1024x20+0-0" 6
NoTitle { "TWM Icon Manager" "idesk" }
IconManagerDontShow { "idesk" }

Color
{
    BorderColor "black"
    DefaultBackground "gray80"
    DefaultForeground "black"
    TitleBackground "gray70"
    TitleForeground "black"
    MenuBackground "gray80"
    MenuForeground "black"
    MenuTitleBackground "gray60"
    MenuTitleForeground "black"
    IconManagerBackground "gray80"
    IconManagerForeground "black"
    IconManagerHighlight "white"
}

LeftTitleButton ":xlogo" = f.delete

MoveDelta 3
Function "move-or-raise" { f.move f.deltastop f.raise }

Button1 = : root : f.menu "main"
Button1 = : title : f.function "move-or-raise"
Button2 = : title : f.raiselower
Button1 = : iconmgr : f.iconify
Button3 = : iconmgr : f.iconify

menu "main"
{
"Programs"	f.title
"Bike Geometry"	f.exec "open-webapp bike-geometry &"
"cv.pdf"	f.exec "flaxpdf /home/tc/Desktop/cv.pdf &"
"xterm"		f.exec "aterm &"
""		f.nop
"Restart twm"	f.restart
}
